# ─── Runtime ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
# Comma-separated list of origins allowed to call the API (the web app)
CORS_ORIGINS=http://localhost:5173

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://crossmart:crossmart@localhost:5432/crossmart

# ─── Redis (job queues) ────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── MCP server ────────────────────────────────────────────
# Base URL of the Crossmart API the MCP server talks to
CROSSMART_API_URL=http://localhost:3000
