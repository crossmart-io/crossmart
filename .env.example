# ─── Runtime ───────────────────────────────────────────────
NODE_ENV=development
API_PORT=3000
# Comma-separated list of origins allowed to call the API (the web app)
CORS_ORIGINS=http://localhost:5173

# ─── Database ──────────────────────────────────────────────
# Required by compose.yaml, which creates the database user with it. Use a URL-safe value
# (openssl rand -hex 24) and put the same one in DATABASE_URL.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://crossmart:<POSTGRES_PASSWORD>@localhost:5432/crossmart

# ─── Redis (job queues, rate limits, one-time tokens) ──────
# Required by compose.yaml, which starts Redis with --requirepass. Use a URL-safe value
# (openssl rand -hex 24) and put the same one in REDIS_URL.
REDIS_PASSWORD=
REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

# ─── Auth ──────────────────────────────────────────────────
# Signs sessions and cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this API
BETTER_AUTH_URL=http://localhost:3000

# ─── File storage ──────────────────────────────────────────
# local: files on disk, served by the API at MEDIA_PUBLIC_URL (development, self-hosting)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage
MEDIA_PUBLIC_URL=http://localhost:3000/media

# ─── Email ─────────────────────────────────────────────────
# log: write emails to the log (development). resend: send through resend.com.
MAIL_DRIVER=log
# Resend API key with sending access; required when MAIL_DRIVER=resend. Never commit it.
RESEND_API_KEY=
MAIL_FROM=Crossmart <hello@crossmart.io>

# ─── Web app ───────────────────────────────────────────────
# Where channel connections send the merchant back to
WEB_APP_URL=http://localhost:5173
# The remote MCP server, with its path. Agents' OAuth access tokens are issued for it.
MCP_PUBLIC_URL=http://localhost:3100/mcp
# Public URL channels reach this API at (OAuth callback, webhooks). Defaults to BETTER_AUTH_URL.
# Set it to an HTTPS tunnel URL to receive Shopify webhooks locally.
# API_PUBLIC_URL=https://example.trycloudflare.com

# ─── Channel credentials ───────────────────────────────────
# Wraps the per-workspace keys that encrypt channel credentials (AES-256-GCM).
# Generate with: openssl rand -base64 32. Without it, channels cannot be connected.
CREDENTIALS_MASTER_KEY=
# Increase when rotating the key, and move the old one to CREDENTIALS_RETIRED_MASTER_KEYS
CREDENTIALS_MASTER_KEY_VERSION=1
# Previous keys, kept until every data key is rewrapped: 1:<key>,2:<key>
CREDENTIALS_RETIRED_MASTER_KEYS=

# ─── Shopify app (Shopify Dev Dashboard) ───────────────────
# See docs/channels/shopify.md for the app settings. Never commit the secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# ─── eBay app (eBay Developers Program) ────────────────────
# See docs/channels/ebay.md. eBay is enabled when the client id, secret and RuName are all set.
# Never commit the secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# The RuName eBay issued for the callback URL ({API_PUBLIC_URL}/api/v1/channels/ebay/oauth/callback)
EBAY_RU_NAME=
# sandbox (default) or production; it must match the keyset above
EBAY_ENVIRONMENT=sandbox
# Verification token of the marketplace account deletion endpoint
# ({API_PUBLIC_URL}/api/v1/webhooks/ebay/account-deletion), entered in the eBay developer portal
# under Alerts & Notifications. 32-80 letters, digits, _ or -. Required for production keys.
EBAY_VERIFICATION_TOKEN=

# ─── Google Merchant Center (Google Cloud OAuth client) ────
# See docs/channels/google-merchant.md. A Web application client in a project with the Merchant
# API enabled. Redirect URI: {API_PUBLIC_URL}/api/v1/channels/google_merchant/oauth/callback
# Never commit the secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Etsy app (etsy.com/developers/your-apps) ──────────────
# See docs/channels/etsy.md. Etsy is enabled when both are set. Callback URL to register:
# {API_PUBLIC_URL}/api/v1/channels/etsy/oauth/callback. Never commit the shared secret.
ETSY_API_KEY=
ETSY_SHARED_SECRET=

# ─── Mercado Libre app (developers.mercadolibre.com, DevCenter) ──────────────
# See docs/channels/mercadolibre.md. Mercado Libre is enabled when both are set. Redirect URI to
# register: {API_PUBLIC_URL}/api/v1/channels/mercado_libre/oauth/callback. Notifications URL:
# {API_PUBLIC_URL}/api/v1/webhooks/mercado_libre. Never commit the Secret Key.
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=

# ─── Plans ─────────────────────────────────────────────────
# true: plan limits block actions with HTTP 402. false (default): they are only reported.
# With billing on, it also makes organizations without a paid subscription read-only.
ENTITLEMENTS_ENFORCED=false

# ─── Billing (ADR 0024, docs/billing.md) ──────────────────
# none (default): no billing, as self-hosting runs. stripe: sell the plans through Stripe.
BILLING_DRIVER=none
# Stripe secret key (sk_test_... while testing). Required with stripe. Never commit it.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint {API_PUBLIC_URL}/api/v1/billing/webhooks/stripe
# (or of `stripe listen` locally). Without it, billing events are refused.
STRIPE_WEBHOOK_SECRET=
# The Customer Portal configuration printed by `pnpm billing:sync-stripe` (lets customers switch plans)
STRIPE_PORTAL_CONFIGURATION_ID=
# true: Stripe Tax computes tax at checkout (set Stripe Tax up in the dashboard first)
STRIPE_AUTOMATIC_TAX=false
# Trial days of a first subscription (card required), and full-access days after a failed payment
BILLING_TRIAL_DAYS=7
BILLING_PAST_DUE_GRACE_DAYS=7
# Optional ISO date when organizations from before billing must choose a plan; unset keeps them for good
# BILLING_LEGACY_ACCESS_UNTIL=2027-01-31
# Where plans that are not sold online (Enterprise) send people
BILLING_SALES_EMAIL=hello@crossmart.io

# ─── Outgoing webhooks (ADR 0023) ─────────────────────────
# true: webhook endpoints may use plain http and private addresses (an n8n on your own network).
# Self-hosting on a trusted network only; never where untrusted users add endpoints.
WEBHOOK_ALLOW_PRIVATE_URLS=false

# ─── AI agents ─────────────────────────────────────────────
# Anthropic API key for the AI agents (content generation). Leave empty to turn AI off:
# the app still runs and AI features say AI is not configured. Never commit the key.
ANTHROPIC_API_KEY=
# Optional: the model the agents use (default claude-sonnet-5-5)
# AI_MODEL=claude-sonnet-5-5
# Optional: the model Agent Worker's chat uses (ADR 0026; default claude-sonnet-5-5)
# AGENT_WORKER_MODEL=claude-sonnet-5-5

# ─── Ask Crossmart (ADR 0022) ─────────────────────────────
# Questions answered per UTC day across the platform; Crossmart pays for them. 0 turns Ask off.
ASK_DAILY_QUESTION_CAP=1000
# Optional: the model Ask answers with (default: AI_MODEL)
# ASK_AI_MODEL=claude-haiku-5-5
# Where Ask sends people it cannot answer
ASK_SUPPORT_EMAIL=hello@crossmart.io
# Who is emailed, with the whole conversation, when someone asks for a person (ADR 0025)
ASK_ESCALATION_EMAIL=hello@crossmart.io
# Comma-separated, verified emails of the platform admins: they read Ask's stored conversations
# and answer escalations. Empty: nobody.
PLATFORM_ADMIN_EMAILS=

# ─── MCP server ────────────────────────────────────────────
# Base URL of the Crossmart API the MCP server talks to
CROSSMART_API_URL=http://localhost:3000
