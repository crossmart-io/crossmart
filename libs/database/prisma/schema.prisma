// Crossmart database schema.
// Conventions: camelCase fields mapped to snake_case columns, plural snake_case table names,
// UUID primary keys, and `workspaceId` on every tenant-scoped table.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (owned by Better Auth; field names follow its schema) ───────────

model User {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  email         String            @unique
  emailVerified Boolean           @default(false) @map("email_verified")
  image         String?
  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  apiKeys       ApiKey[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  VIEWER

  @@map("workspace_role")
}

model Organization {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  workspaces Workspace[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("organizations")
}

model Workspace {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  /// ISO 4217 code the catalog's prices are in.
  currency       String            @default("USD") @db.Char(3)
  members        WorkspaceMember[]
  apiKeys        ApiKey[]
  products       Product[]
  productViews   ProductView[]
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// A workspace-scoped key for the API and MCP. Only a SHA-256 hash of the secret is stored.
model ApiKey {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String        @map("created_by_id") @db.Uuid
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name        String
  role        WorkspaceRole
  prefix      String
  hash        String        @unique
  lastUsedAt  DateTime?     @map("last_used_at")
  expiresAt   DateTime?     @map("expires_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("api_keys")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OutOfStockPolicy {
  STOP_SELLING
  CONTINUE_SELLING

  @@map("out_of_stock_policy")
}

/// A saved filter of the product list, shared by everyone in the workspace.
model ProductView {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  search      String?
  status      ProductStatus?
  /// A `CatalogGap` value; validated by the API, kept as text so new gaps need no migration.
  gap         String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([workspaceId, name])
  @@map("product_views")
}

/// A product with its base content. Per-channel overrides live on its listings.
model Product {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  handle          String
  title           String
  descriptionHtml String         @default("") @map("description_html")
  vendor          String?
  productType     String?        @map("product_type")
  tags            String[]
  status          ProductStatus  @default(DRAFT)
  /// Names of up to three options (Size, Color). Each variant holds one value per name, in order.
  optionNames     String[]       @map("option_names")
  variants        Variant[]
  media           ProductMedia[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([workspaceId, handle])
  @@index([workspaceId, title, id])
  @@map("products")
}

model Variant {
  id               String           @id @default(uuid()) @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  productId        String           @map("product_id") @db.Uuid
  product          Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  position         Int
  sku              String?
  barcode          String?
  optionValues     String[]         @map("option_values")
  price            Decimal          @db.Decimal(12, 2)
  compareAtPrice   Decimal?         @map("compare_at_price") @db.Decimal(12, 2)
  weightGrams      Int?             @map("weight_grams")
  requiresShipping Boolean          @default(true) @map("requires_shipping")
  taxable          Boolean          @default(true)
  outOfStockPolicy OutOfStockPolicy @default(STOP_SELLING) @map("out_of_stock_policy")
  inventoryItem    InventoryItem?
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([workspaceId, sku])
  @@index([productId, position])
  @@map("variants")
}

model ProductMedia {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  altText     String?  @map("alt_text")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId, position])
  @@map("product_media")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum InventoryMovementReason {
  OPENING_BALANCE
  ADJUSTMENT

  @@map("inventory_movement_reason")
}

/// Stock of one variant. `available` caches the sum of its movements and is updated atomically.
model InventoryItem {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  variantId   String              @unique @map("variant_id") @db.Uuid
  variant     Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tracked     Boolean             @default(true)
  available   Int                 @default(0)
  movements   InventoryMovement[]
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("inventory_items")
}

/// Append-only stock ledger.
model InventoryMovement {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @map("workspace_id") @db.Uuid
  inventoryItemId String                  @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  delta           Int
  reason          InventoryMovementReason
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([inventoryItemId, createdAt])
  @@map("inventory_movements")
}
