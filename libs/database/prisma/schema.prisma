// Crossmart database schema.
// Conventions: camelCase fields mapped to snake_case columns, plural snake_case table names,
// UUID primary keys, and `workspaceId` on every tenant-scoped table.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (owned by Better Auth; field names follow its schema) ───────────

model User {
  id            String              @id @default(uuid()) @db.Uuid
  name          String
  email         String              @unique
  emailVerified Boolean             @default(false) @map("email_verified")
  image         String?
  sessions      Session[]
  accounts      Account[]
  memberships   WorkspaceMember[]
  apiKeys       ApiKey[]
  activity      ActivityEvent[]
  stockMoves    InventoryMovement[]
  importJobs    ImportJob[]
  connections   ChannelConnection[]
  invitations   WorkspaceInvitation[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  VIEWER

  @@map("workspace_role")
}

model Organization {
  id         String      @id @default(uuid()) @db.Uuid
  name       String
  workspaces Workspace[]
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@map("organizations")
}

model Workspace {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  /// ISO 4217 code the catalog's prices are in.
  currency       String              @default("USD") @db.Char(3)
  members        WorkspaceMember[]
  invitations    WorkspaceInvitation[]
  apiKeys        ApiKey[]
  products       Product[]
  productViews   ProductView[]
  activity       ActivityEvent[]
  importJobs     ImportJob[]
  orders         Order[]
  dataKey        WorkspaceDataKey?
  connections    ChannelConnection[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String        @map("user_id") @db.Uuid
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

/// An emailed invitation to join a workspace with a role. Only a SHA-256 hash of the link's token
/// is stored. Pending while neither accepted nor revoked, until it expires.
model WorkspaceInvitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Lowercased, so it matches the invitee's account whatever case they type.
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique @map("token_hash")
  invitedById String        @map("invited_by_id") @db.Uuid
  invitedBy   User          @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

/// A workspace-scoped key for the API and MCP. Only a SHA-256 hash of the secret is stored.
model ApiKey {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String              @map("created_by_id") @db.Uuid
  createdBy   User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name        String
  role        WorkspaceRole
  prefix      String
  hash        String              @unique
  lastUsedAt  DateTime?           @map("last_used_at")
  expiresAt   DateTime?           @map("expires_at")
  revokedAt   DateTime?           @map("revoked_at")
  activity    ActivityEvent[]
  stockMoves  InventoryMovement[]
  createdAt   DateTime            @default(now()) @map("created_at")
  importJobs  ImportJob[]

  @@index([workspaceId])
  @@map("api_keys")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OutOfStockPolicy {
  STOP_SELLING
  CONTINUE_SELLING

  @@map("out_of_stock_policy")
}

/// A saved filter of the product list, shared by everyone in the workspace.
model ProductView {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  search      String?
  status      ProductStatus?
  /// A `CatalogGap` value; validated by the API, kept as text so new gaps need no migration.
  gap         String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([workspaceId, name])
  @@map("product_views")
}

/// A product with its base content. Per-channel overrides live on its listings.
model Product {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  handle          String
  title           String
  descriptionHtml String         @default("") @map("description_html")
  vendor          String?
  productType     String?        @map("product_type")
  tags            String[]
  status          ProductStatus  @default(DRAFT)
  /// Names of up to three options (Size, Color). Each variant holds one value per name, in order.
  optionNames     String[]       @map("option_names")
  variants        Variant[]
  media           ProductMedia[]
  listings        Listing[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([workspaceId, handle])
  @@index([workspaceId, title, id])
  @@map("products")
}

model Variant {
  id               String                   @id @default(uuid()) @db.Uuid
  workspaceId      String                   @map("workspace_id") @db.Uuid
  productId        String                   @map("product_id") @db.Uuid
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position         Int
  sku              String?
  barcode          String?
  optionValues     String[]                 @map("option_values")
  price            Decimal                  @db.Decimal(12, 2)
  compareAtPrice   Decimal?                 @map("compare_at_price") @db.Decimal(12, 2)
  /// What the merchant pays per unit. Drives pricing floors; never shown to buyers.
  cost             Decimal?                 @db.Decimal(12, 2)
  weightGrams      Int?                     @map("weight_grams")
  requiresShipping Boolean                  @default(true) @map("requires_shipping")
  taxable          Boolean                  @default(true)
  outOfStockPolicy OutOfStockPolicy         @default(STOP_SELLING) @map("out_of_stock_policy")
  inventoryItem    InventoryItem?
  listingVariants  ListingVariant[]
  listingPrices    ListingVariantOverride[]
  orderLines       OrderLine[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@unique([workspaceId, sku])
  @@index([productId, position])
  @@map("variants")
}

model ProductMedia {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  altText     String?  @map("alt_text")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId, position])
  @@map("product_media")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum InventoryMovementReason {
  /// Stock a variant was created or imported with.
  OPENING_BALANCE
  /// Stock changed by editing the product.
  ADJUSTMENT
  /// A count that corrects the recorded stock.
  CORRECTION
  RECEIVED
  RETURNED
  DAMAGED
  LOST
  /// Sold outside a connected channel (a market stall, a wholesale order).
  SOLD
  /// Stock set by an inventory file import.
  IMPORTED
  /// Units a channel order shipped: they leave the stock on hand.
  ORDER_SHIPPED

  @@map("inventory_movement_reason")
}

/// Stock of one variant. On hand = `available` + `reserved`.
/// `available` can be sold and is what channels receive; `reserved` is held for open orders.
/// The movements sum to the stock on hand, and both columns are updated atomically with them.
model InventoryItem {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  variantId   String              @unique @map("variant_id") @db.Uuid
  variant     Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tracked     Boolean             @default(true)
  available   Int                 @default(0)
  reserved    Int                 @default(0)
  movements   InventoryMovement[]
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, tracked, available])
  @@map("inventory_items")
}

/// Append-only ledger of changes to the stock on hand. Reservations move units between
/// `available` and `reserved` and are not movements.
model InventoryMovement {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @map("workspace_id") @db.Uuid
  inventoryItemId String                  @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  delta           Int
  reason          InventoryMovementReason
  /// Stock on hand right after this movement.
  quantityAfter   Int                     @map("quantity_after")
  note            String?
  /// The signed-in user who made the change; null for API keys, the system and deleted users.
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  actorUser       User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Set when the change came through an API key (an agent or a script).
  apiKeyId        String?                 @map("api_key_id") @db.Uuid
  apiKey          ApiKey?                 @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([inventoryItemId, createdAt])
  @@index([actorUserId])
  @@index([apiKeyId])
  @@map("inventory_movements")
}

// ─── Activity ─────────────────────────────────────────────────────────────────

enum ActivityActorType {
  USER
  API_KEY
  SYSTEM

  @@map("activity_actor_type")
}

enum ActivityOutcome {
  SUCCEEDED
  FAILED

  @@map("activity_outcome")
}

/// Append-only record of who changed what in a workspace, including operations that failed.
/// UUIDv7 ids sort by time, so they break ties between events of the same millisecond.
model ActivityEvent {
  id            String            @id @default(uuid(7)) @db.Uuid
  workspaceId   String            @map("workspace_id") @db.Uuid
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorType     ActivityActorType @map("actor_type")
  /// Kept as null when the user is deleted, so the history survives them.
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  actorUser     User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiKeyId String?           @map("actor_api_key_id") @db.Uuid
  actorApiKey   ApiKey?           @relation(fields: [actorApiKeyId], references: [id], onDelete: SetNull)
  /// An `ActivityAction` value; kept as text so features can add actions without a migration.
  action        String
  outcome       ActivityOutcome
  /// An `ActivitySubjectType` value, kept as text for the same reason.
  subjectType   String?           @map("subject_type")
  subjectId     String?           @map("subject_id") @db.Uuid
  /// The subject's name when the event happened, so deleted subjects still read well.
  subjectLabel  String?           @map("subject_label")
  /// Every subject a bulk event touched, so each one's history includes it.
  subjectIds    String[]          @map("subject_ids") @db.Uuid
  /// How many items the event covered (products changed, products imported).
  itemCount     Int?              @map("item_count")
  /// A short, user-facing reason for a failed outcome. Never holds secrets.
  failureReason String?           @map("failure_reason")
  summary       String
  createdAt     DateTime          @default(now()) @map("created_at")

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, subjectType, subjectId])
  @@index([subjectIds], type: Gin)
  @@map("activity_events")
}

// ─── Imports ──────────────────────────────────────────────────────────────────

enum ImportJobStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("import_job_status")
}

enum ImportIssueOutcome {
  /// The record was left as it was (already in the catalog, not found, stock not tracked).
  SKIPPED
  /// The record could not be imported (invalid value, unknown SKU, SKU clash).
  FAILED

  @@map("import_issue_outcome")
}

/// One import and what it did to the catalog, from an uploaded file or a channel's catalog:
/// the workspace's import history.
model ImportJob {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The signed-in user who sent the file; null for API keys and deleted users.
  userId       String?            @map("user_id") @db.Uuid
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The API key that sent the file, if one did.
  apiKeyId     String?            @map("api_key_id") @db.Uuid
  apiKey       ApiKey?            @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  /// A `CatalogImportMode` value; validated by the API, kept as text so new modes need no migration.
  mode         String
  /// A `CatalogImportFormat` value, kept as text for the same reason.
  format       String
  /// The uploaded file's name, or the name of the channel account a channel import read.
  fileName     String             @map("file_name")
  /// The channel account a channel import reads; null for file imports and deleted connections.
  connectionId String?            @map("connection_id") @db.Uuid
  connection   ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// Where a channel import resumes: the channel's cursor after the last page it wrote.
  cursor       String?
  /// How many records the source holds, when it says, so progress can be shown.
  totalCount   Int?               @map("total_count")
  status       ImportJobStatus    @default(PROCESSING)
  createdCount Int                @default(0) @map("created_count")
  /// Channel products matched to catalog products (by handle or SKU) and linked to them.
  linkedCount  Int                @default(0) @map("linked_count")
  updatedCount Int                @default(0) @map("updated_count")
  skippedCount Int                @default(0) @map("skipped_count")
  failedCount  Int                @default(0) @map("failed_count")
  /// Why the whole file was rejected, when `status` is FAILED.
  errorMessage String?            @map("error_message")
  issues       ImportJobIssue[]
  createdAt    DateTime           @default(now()) @map("created_at")
  /// Moves with every page a running import writes, so a stalled one can be found.
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at")
  finishedAt   DateTime?          @map("finished_at")

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([connectionId, status])
  @@index([status, updatedAt])
  @@map("import_jobs")
}

/// A skipped or failed record of an import, in file order.
model ImportJobIssue {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  jobId       String             @map("job_id") @db.Uuid
  job         ImportJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  position    Int
  outcome     ImportIssueOutcome
  /// An `ImportIssueCode` value, kept as text so new codes need no migration.
  code        String
  message     String
  handle      String?
  sku         String?
  /// Spreadsheet row number, counting the header as row 1.
  row         Int?

  @@index([jobId, position])
  @@map("import_job_issues")
}

// ─── Channels ─────────────────────────────────────────────────────────────────

/// The key that encrypts a workspace's secrets (channel credentials), wrapped by a master key.
model WorkspaceDataKey {
  workspaceId      String    @id @map("workspace_id") @db.Uuid
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// AES-256-GCM sealed data key; never stored in plain text.
  wrappedKey       String    @map("wrapped_key")
  /// Which master key wrapped it, so keys can be rotated.
  masterKeyVersion Int       @map("master_key_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("workspace_data_keys")
}

enum ChannelConnectionStatus {
  CONNECTED
  /// The channel no longer accepts the credentials; the merchant must connect again.
  NEEDS_REAUTH
  /// Disconnected by the merchant, or the app was uninstalled. Credentials are wiped.
  DISCONNECTED
  /// The last sync or account check failed for another reason.
  ERROR

  @@map("channel_connection_status")
}

/// A workspace's account on a channel, such as one Shopify store.
model ChannelConnection {
  id                   String                  @id @default(uuid()) @db.Uuid
  workspaceId          String                  @map("workspace_id") @db.Uuid
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// A `ChannelType` value; kept as text so new channels need no migration.
  channel              String
  /// The account on the channel: a Shopify store's `*.myshopify.com` domain.
  externalAccountId    String                  @map("external_account_id")
  displayName          String                  @map("display_name")
  status               ChannelConnectionStatus @default(CONNECTED)
  /// The connector's credentials as JSON, sealed with the workspace data key. Null once wiped.
  credentials          String?
  /// When the access token expires, so it can be refreshed ahead of time. Not a secret.
  credentialsExpiresAt DateTime?               @map("credentials_expires_at")
  grantedScopes        String[]                @map("granted_scopes")
  /// Account settings typed per channel and validated by its connector (currency, location).
  settings             Json                    @default("{}")
  /// A short, user-facing reason for `NEEDS_REAUTH` or `ERROR`. Never holds secrets.
  statusReason         String?                 @map("status_reason")
  connectedById        String?                 @map("connected_by_id") @db.Uuid
  connectedBy          User?                   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt          DateTime                @default(now()) @map("connected_at")
  disconnectedAt       DateTime?               @map("disconnected_at")
  lastSyncedAt         DateTime?               @map("last_synced_at")
  /// Orders changed up to this time have been read; the next poll reads from here.
  ordersPolledAt       DateTime?               @map("orders_polled_at")
  /// When Crossmart started reading orders; earlier orders were sold from stock it never held.
  ordersSyncedFrom     DateTime?               @map("orders_synced_from")
  listings             Listing[]
  importJobs           ImportJob[]
  orders               Order[]
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@unique([workspaceId, channel, externalAccountId])
  /// Webhooks name the account, not the workspace.
  @@index([channel, externalAccountId])
  @@map("channel_connections")
}

enum ListingStatus {
  /// Waiting to be published.
  PENDING
  /// Live on the channel.
  ACTIVE
  /// On the channel but not for sale (a draft or archived product).
  INACTIVE
  /// The last publish or update failed; see `lastError`.
  ERROR
  /// Removed from the channel.
  DELISTED

  @@map("listing_status")
}

/// How a product joined a connection, which decides how it leaves.
enum ListingSource {
  /// Added to the store by hand; it stays until it is removed by hand.
  MANUAL
  /// Brought in by a catalog import from the channel; it stays like a manual one.
  IMPORT
  /// Matched the connection's automatic rule; it leaves when the rule stops matching.
  RULE

  @@map("listing_source")
}

/// A product on one channel connection, with the ids the channel gave it. A product may have
/// several listings on one connection (eBay variations of title or pack size), so only the
/// external id is unique per connection.
model Listing {
  id               String                   @id @default(uuid()) @db.Uuid
  workspaceId      String                   @map("workspace_id") @db.Uuid
  connectionId     String                   @map("connection_id") @db.Uuid
  connection       ChannelConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  productId        String                   @map("product_id") @db.Uuid
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The product's id on the channel (a Shopify product GID); null until it is published.
  externalId       String?                  @map("external_id")
  externalUrl      String?                  @map("external_url")
  status           ListingStatus            @default(PENDING)
  source           ListingSource            @default(RULE)
  /// A short, user-facing reason for `ERROR`. Never holds secrets.
  lastError        String?                  @map("last_error")
  lastSyncedAt     DateTime?                @map("last_synced_at")
  /// A digest of the images last sent, so an update re-sends media only when they changed.
  mediaDigest      String?                  @map("media_digest")
  variants         ListingVariant[]
  override         ListingOverride?
  variantOverrides ListingVariantOverride[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@unique([connectionId, externalId])
  @@index([connectionId, status])
  @@index([connectionId, source])
  @@index([connectionId, productId])
  @@index([workspaceId, productId])
  @@map("listings")
}

/// Maps a variant to its ids on a listing's channel, for price and stock sync.
model ListingVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  listingId           String   @map("listing_id") @db.Uuid
  listing             Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variantId           String   @map("variant_id") @db.Uuid
  variant             Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// The variant's id on the channel (a Shopify ProductVariant GID).
  externalId          String   @map("external_id")
  /// The id stock is set on, where the channel has one (a Shopify InventoryItem GID).
  externalInventoryId String?  @map("external_inventory_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([listingId, variantId])
  @@unique([listingId, externalId])
  @@index([variantId])
  @@map("listing_variants")
}

/// Whether a listing is for sale on its channel, when the merchant decides it per channel.
enum ListingVisibility {
  /// For sale on the channel, even while the product is a draft in Crossmart.
  VISIBLE
  /// On the channel but hidden (a draft there), whatever the product's status.
  HIDDEN

  @@map("listing_visibility")
}

/// What one listing shows differently from the product (ChannelContent). Null fields follow the product.
model ListingOverride {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  listingId       String             @unique @map("listing_id") @db.Uuid
  listing         Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title           String?
  descriptionHtml String?            @map("description_html")
  /// Tags replace the product's when `tagsOverridden` is set (an empty list means no tags).
  tagsOverridden  Boolean            @default(false) @map("tags_overridden")
  tags            String[]
  /// The product's images to show, in order, by URL, when `mediaOverridden` is set.
  mediaOverridden Boolean            @default(false) @map("media_overridden")
  mediaUrls       String[]           @map("media_urls")
  visibility      ListingVisibility?
  /// Units held back from this channel: it shows available minus the buffer.
  inventoryBuffer Int?               @map("inventory_buffer")
  /// The most units this channel shows, however many are available.
  maxQuantity     Int?               @map("max_quantity")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("listing_overrides")
}

/// A fixed price for one variant on one listing, ahead of the connection's pricing rule.
model ListingVariantOverride {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variantId      String   @map("variant_id") @db.Uuid
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([listingId, variantId])
  @@index([variantId])
  @@map("listing_variant_overrides")
}

/// Where a channel order stands, from its lines: nothing shipped, some, all, or cancelled.
enum OrderStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED

  @@map("order_status")
}

/// An order from a connected channel, kept once per channel order. It holds no buyer details.
model Order {
  id                String            @id @default(uuid()) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId      String            @map("connection_id") @db.Uuid
  connection        ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId        String            @map("external_id")
  /// The number the merchant and buyer see, such as `#1001`.
  name              String
  status            OrderStatus
  currencyCode      String            @map("currency_code")
  total             Decimal           @db.Decimal(12, 2)
  placedAt          DateTime          @map("placed_at")
  /// When the channel last changed the order, so an older copy never overwrites a newer one.
  externalUpdatedAt DateTime          @map("external_updated_at")
  lines             OrderLine[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([connectionId, externalId])
  @@index([workspaceId, placedAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, status])
  @@map("orders")
}

/// One line of an order, and the stock it holds: `reservedQuantity` waits to ship,
/// `fulfilledQuantity` has left the stock on hand. Lines that match no variant hold none.
model OrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId        String   @map("external_id")
  variantId         String?  @map("variant_id") @db.Uuid
  variant           Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku               String?
  title             String
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  fulfilledQuantity Int      @default(0) @map("fulfilled_quantity")

  @@unique([orderId, externalId])
  @@index([variantId])
  @@map("order_lines")
}
