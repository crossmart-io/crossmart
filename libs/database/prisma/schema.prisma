// Crossmart database schema.
// Conventions: camelCase fields mapped to snake_case columns, plural snake_case table names,
// UUID primary keys, and `workspaceId` on every tenant-scoped table.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Identity (owned by Better Auth; field names follow its schema) ───────────

model User {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String
  email                String                @unique
  emailVerified        Boolean               @default(false) @map("email_verified")
  image                String?
  sessions             Session[]
  accounts             Account[]
  memberships          WorkspaceMember[]
  apiKeys              ApiKey[]
  activity             ActivityEvent[]
  stockMoves           InventoryMovement[]
  importJobs           ImportJob[]
  connections          ChannelConnection[]
  invitations          WorkspaceInvitation[]
  suggestionsRequested Suggestion[]          @relation("SuggestionRequestedBy")
  suggestionsReviewed  Suggestion[]          @relation("SuggestionReviewedBy")
  oauthClients         OauthClient[]
  oauthRefreshTokens   OauthRefreshToken[]
  oauthAccessTokens    OauthAccessToken[]
  oauthConsents        OauthConsent[]
  sandboxAccount       SandboxAccount?
  askConversations     AskConversation[]
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  @@map("users")
}

model Session {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @map("user_id") @db.Uuid
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  token              String              @unique
  expiresAt          DateTime            @map("expires_at")
  ipAddress          String?             @map("ip_address")
  userAgent          String?             @map("user_agent")
  /// The workspace picked for an agent during an OAuth authorization, before consent.
  oauthWorkspaceId   String?             @map("oauth_workspace_id") @db.Uuid
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ─── Agent OAuth (owned by Better Auth's OAuth provider; see ADR 0019) ────────
// A consent's and a token's `referenceId` is the workspace the agent was given.

model Jwks {
  id         String    @id @default(uuid()) @db.Uuid
  publicKey  String    @map("public_key")
  privateKey String    @map("private_key")
  alg        String?
  crv        String?
  createdAt  DateTime  @map("created_at")
  expiresAt  DateTime? @map("expires_at")

  @@map("jwks")
}

model OauthClient {
  id                               String                @id @default(uuid()) @db.Uuid
  /// A Client ID Metadata Document URL, or a generated id for a dynamically registered client.
  clientId                         String                @unique @map("client_id")
  clientSecret                     String?               @map("client_secret")
  clientDiscoveryId                String?               @map("client_discovery_id")
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?              @map("skip_consent")
  enableEndSession                 Boolean?              @map("enable_end_session")
  subjectType                      String?               @map("subject_type")
  scopes                           String[]
  clientCredentialsScopes          String[]              @default([]) @map("client_credentials_scopes")
  userId                           String?               @map("user_id") @db.Uuid
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?               @map("software_id")
  softwareVersion                  String?               @map("software_version")
  softwareStatement                String?               @map("software_statement")
  redirectUris                     String[]              @map("redirect_uris")
  postLogoutRedirectUris           String[]              @map("post_logout_redirect_uris")
  backchannelLogoutUri             String?               @map("backchannel_logout_uri")
  backchannelLogoutSessionRequired Boolean?              @map("backchannel_logout_session_required")
  tokenEndpointAuthMethod          String?               @map("token_endpoint_auth_method")
  applicationType                  String?               @map("application_type")
  jwks                             String?
  jwksUri                          String?               @map("jwks_uri")
  grantTypes                       String[]              @map("grant_types")
  responseTypes                    String[]              @map("response_types")
  requirePKCE                      Boolean?              @map("require_pkce")
  dpopBoundAccessTokens            Boolean?              @default(false) @map("dpop_bound_access_tokens")
  referenceId                      String?               @map("reference_id")
  metadata                         Json?
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]
  activity                         ActivityEvent[]
  createdAt                        DateTime?             @map("created_at")
  updatedAt                        DateTime?             @map("updated_at")

  @@index([userId])
  @@index([createdAt])
  @@map("oauth_clients")
}

model OauthResource {
  id                            String                @id @default(uuid()) @db.Uuid
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?                  @map("access_token_ttl")
  refreshTokenTtl               Int?                  @map("refresh_token_ttl")
  signingAlgorithm              String?               @map("signing_algorithm")
  signingKeyId                  String?               @map("signing_key_id")
  allowedScopes                 String[]              @map("allowed_scopes")
  customClaims                  Json?                 @map("custom_claims")
  dpopBoundAccessTokensRequired Boolean?              @default(false) @map("dpop_bound_access_tokens_required")
  disabled                      Boolean?              @default(false)
  policyVersion                 Int?                  @default(1) @map("policy_version")
  metadata                      Json?
  clients                       OauthClientResource[]
  createdAt                     DateTime?             @map("created_at")
  updatedAt                     DateTime?             @map("updated_at")

  @@map("oauth_resources")
}

model OauthClientResource {
  id         String        @id @default(uuid()) @db.Uuid
  clientId   String        @map("client_id")
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String        @map("resource_id")
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?     @map("created_at")

  @@unique([clientId, resourceId])
  @@index([resourceId])
  @@map("oauth_client_resources")
}

model OauthRefreshToken {
  id                      String             @id @default(uuid()) @db.Uuid
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id") @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String             @map("user_id") @db.Uuid
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @map("requested_user_info_claims")
  scopes                  String[]
  expiresAt               DateTime           @map("expires_at")
  revoked                 DateTime?
  rotatedAt               DateTime?          @map("rotated_at")
  rotationReplayResponse  String?            @map("rotation_replay_response")
  rotationReplayExpiresAt DateTime?          @map("rotation_replay_expires_at")
  authTime                DateTime?          @map("auth_time")
  confirmation            Json?
  accessTokens            OauthAccessToken[]
  createdAt               DateTime           @map("created_at")

  @@index([clientId])
  @@index([sessionId])
  @@index([userId, clientId, referenceId])
  @@index([authorizationCodeId])
  @@map("oauth_refresh_tokens")
}

model OauthAccessToken {
  id                      String             @id @default(uuid()) @db.Uuid
  token                   String             @unique
  clientId                String             @map("client_id")
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?            @map("session_id") @db.Uuid
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?            @map("user_id") @db.Uuid
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?            @map("reference_id")
  authorizationCodeId     String?            @map("authorization_code_id")
  resources               String[]
  requestedUserInfoClaims String[]           @map("requested_user_info_claims")
  refreshId               String?            @map("refresh_id") @db.Uuid
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  scopes                  String[]
  expiresAt               DateTime           @map("expires_at")
  revoked                 DateTime?
  confirmation            Json?
  createdAt               DateTime           @map("created_at")

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauth_access_tokens")
}

/// A user's consent for an agent in one workspace (`referenceId`): one connected agent.
model OauthConsent {
  id                      String      @id @default(uuid()) @db.Uuid
  clientId                String      @map("client_id")
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?     @map("user_id") @db.Uuid
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?     @map("reference_id")
  resources               String[]
  requestedUserInfoClaims String[]    @map("requested_user_info_claims")
  scopes                  String[]
  createdAt               DateTime    @map("created_at")
  updatedAt               DateTime    @map("updated_at")

  @@index([clientId])
  @@index([userId, clientId, referenceId])
  @@index([referenceId])
  @@map("oauth_consents")
}

/// Client assertion ids (`jti`) already used, so a `private_key_jwt` assertion is never replayed.
model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime @map("expires_at")

  @@map("oauth_client_assertions")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  VIEWER
  /// The permissions come from the workspace's own role, named by `customRoleId`.
  CUSTOM

  @@map("workspace_role")
}

model Organization {
  id           String                    @id @default(uuid()) @db.Uuid
  name         String
  workspaces   Workspace[]
  subscription OrganizationSubscription?
  /// Set while an AI agent's sandbox account awaits its owner, and kept once claimed (ADR 0019).
  sandbox      SandboxAccount?
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  @@map("organizations")
}

model Workspace {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  slug              String
  /// ISO 4217 code the catalog's prices are in.
  currency          String                @default("USD") @db.Char(3)
  /// IANA zone that sets where a day starts for reports, such as "Asia/Jerusalem". Null until set.
  timeZone          String?               @map("time_zone")
  members           WorkspaceMember[]
  invitations       WorkspaceInvitation[]
  customRoles       CustomRole[]
  apiKeys           ApiKey[]
  products          Product[]
  productViews      ProductView[]
  activity          ActivityEvent[]
  importJobs        ImportJob[]
  orders            Order[]
  dataKey           WorkspaceDataKey?
  connections       ChannelConnection[]
  suggestions       Suggestion[]
  aiUsage           AiUsage[]
  webhookEndpoints  WebhookEndpoint[]
  webhookEvents     WebhookEvent[]
  webhookDeliveries WebhookDelivery[]
  sandboxAccount    SandboxAccount?
  askConversations  AskConversation[]
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("workspaces")
}

model WorkspaceMember {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String        @map("user_id") @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         WorkspaceRole
  /// Set exactly when `role` is CUSTOM (a check constraint enforces it).
  customRoleId String?       @map("custom_role_id") @db.Uuid
  customRole   CustomRole?   @relation(fields: [customRoleId], references: [id], onDelete: NoAction)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([customRoleId])
  @@index([userId])
  @@map("workspace_members")
}

/// A role a workspace defines itself: a name and a set of `WorkspacePermission` values.
model CustomRole {
  id          String                @id @default(uuid()) @db.Uuid
  workspaceId String                @map("workspace_id") @db.Uuid
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]
  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  apiKeys     ApiKey[]
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  @@unique([workspaceId, name])
  @@map("custom_roles")
}

/// An emailed invitation to join a workspace with a role. Only a SHA-256 hash of the link's token
/// is stored. Pending while neither accepted nor revoked, until it expires.
model WorkspaceInvitation {
  id           String        @id @default(uuid()) @db.Uuid
  workspaceId  String        @map("workspace_id") @db.Uuid
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Lowercased, so it matches the invitee's account whatever case they type.
  email        String
  role         WorkspaceRole
  /// The custom role for a CUSTOM invitation; null once that role is deleted, which grants nothing.
  customRoleId String?       @map("custom_role_id") @db.Uuid
  customRole   CustomRole?   @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  tokenHash    String        @unique @map("token_hash")
  invitedById  String        @map("invited_by_id") @db.Uuid
  invitedBy    User          @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  expiresAt    DateTime      @map("expires_at")
  acceptedAt   DateTime?     @map("accepted_at")
  revokedAt    DateTime?     @map("revoked_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@index([workspaceId, email])
  @@map("workspace_invitations")
}

/// A workspace-scoped key for the API and MCP. Only a SHA-256 hash of the secret is stored.
model ApiKey {
  id                   String              @id @default(uuid()) @db.Uuid
  workspaceId          String              @map("workspace_id") @db.Uuid
  workspace            Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById          String              @map("created_by_id") @db.Uuid
  createdBy            User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  name                 String
  role                 WorkspaceRole
  /// The custom role for a CUSTOM key; null once that role is deleted, which grants nothing.
  customRoleId         String?             @map("custom_role_id") @db.Uuid
  customRole           CustomRole?         @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  prefix               String
  hash                 String              @unique
  lastUsedAt           DateTime?           @map("last_used_at")
  expiresAt            DateTime?           @map("expires_at")
  revokedAt            DateTime?           @map("revoked_at")
  activity             ActivityEvent[]
  stockMoves           InventoryMovement[]
  createdAt            DateTime            @default(now()) @map("created_at")
  importJobs           ImportJob[]
  suggestionsRequested Suggestion[]        @relation("SuggestionRequestedByKey")
  suggestionsReviewed  Suggestion[]        @relation("SuggestionReviewedByKey")

  @@index([workspaceId])
  @@map("api_keys")
}

/// An account an AI agent opened for someone with no Crossmart account yet (ADR 0019): a user
/// without a password, an organization and its one workspace, which is a sandbox until the person
/// claims it. Only a SHA-256 hash of the claim link's token is stored. While `claimedAt` is null,
/// `EntitlementService` refuses what a sandbox may not do, and the sweep deletes it all once
/// `expiresAt` passes. The row stays after the claim, so a used link never works again.
model SandboxAccount {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @unique @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaceId        String       @unique @map("workspace_id") @db.Uuid
  workspace          Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The person the account is for, who signs in once they claim it.
  userId             String       @unique @map("user_id") @db.Uuid
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Replaced when the reminder is sent, so only the newest emailed link works.
  claimTokenHash     String       @unique @map("claim_token_hash")
  expiresAt          DateTime     @map("expires_at")
  claimEmailSentAt   DateTime     @map("claim_email_sent_at")
  /// When the one reminder went out; null until then.
  claimEmailResentAt DateTime?    @map("claim_email_resent_at")
  claimedAt          DateTime?    @map("claimed_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@index([claimedAt, expiresAt])
  @@map("sandbox_accounts")
}

// ─── Plans and entitlements ───────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  /// A payment failed; the plan still applies while the provider retries.
  PAST_DUE
  CANCELED
  /// No paid subscription has started: checkout was never completed, or its first payment was not.
  INCOMPLETE
  /// The provider stopped retrying a failed payment and left the subscription unpaid.
  UNPAID
  /// The trial ended without a payment method, and the provider paused the subscription.
  PAUSED

  @@map("subscription_status")
}

/// How often a paid subscription renews.
enum BillingInterval {
  MONTHLY
  ANNUAL

  @@map("billing_interval")
}

/// A plan organizations can be on, such as Free or Growth. What it includes lives in its versions,
/// so changing a plan never changes what existing customers have.
model Plan {
  id        String        @id @default(uuid()) @db.Uuid
  /// A stable identifier for links and billing provider metadata, such as "growth".
  code      String        @unique
  name      String
  /// Inactive plans are no longer offered; organizations on them keep them (grandfathering).
  active    Boolean       @default(true)
  /// The plan new organizations start on. Keep one; with several, the lowest `sortOrder` wins.
  isDefault Boolean       @default(false) @map("is_default")
  sortOrder Int           @map("sort_order")
  versions  PlanVersion[]
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@map("plans")
}

/// What a plan includes from one point on. Never edited once organizations are on it: a change
/// is a new version, which new subscriptions get while existing ones keep theirs.
model PlanVersion {
  id            String                     @id @default(uuid()) @db.Uuid
  planId        String                     @map("plan_id") @db.Uuid
  plan          Plan                       @relation(fields: [planId], references: [id], onDelete: Restrict)
  version       Int
  features      PlanFeature[]
  subscriptions OrganizationSubscription[]
  createdAt     DateTime                   @default(now()) @map("created_at")

  @@unique([planId, version])
  @@map("plan_versions")
}

/// One feature of a plan version: a limit, or a flag that is on or off. A feature a version does
/// not list is not included.
model PlanFeature {
  id            String      @id @default(uuid()) @db.Uuid
  planVersionId String      @map("plan_version_id") @db.Uuid
  planVersion   PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  /// A `Feature` value; kept as text so new features need no migration of an enum.
  feature       String
  enabled       Boolean     @default(true)
  /// The most a limit allows; null is unlimited. Unused for flags.
  limit         Int?        @map("limit_value")

  @@unique([planVersionId, feature])
  @@map("plan_features")
}

/// The plan version an organization is on, and its billing (ADR 0024). Every organization has
/// one. The provider fields stay empty until the organization checks out; with billing off they
/// always do. ACTIVE with no provider subscription is an organization from before billing.
model OrganizationSubscription {
  id                     String             @id @default(uuid()) @db.Uuid
  organizationId         String             @unique @map("organization_id") @db.Uuid
  organization           Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planVersionId          String             @map("plan_version_id") @db.Uuid
  planVersion            PlanVersion        @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  status                 SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd       DateTime?          @map("current_period_end")
  /// The organization's customer at the billing provider (a Stripe customer id).
  externalCustomerId     String?            @unique @map("external_customer_id")
  /// The subscription at the billing provider (a Stripe subscription id).
  externalSubscriptionId String?            @unique @map("external_subscription_id")
  /// Null until a paid subscription starts.
  billingInterval        BillingInterval?   @map("billing_interval")
  /// When the trial ends or ended. Set once a trial starts, so an organization trials only once.
  trialEnd               DateTime?          @map("trial_end")
  /// A cancellation is scheduled: the subscription ends at `cancelAt` instead of renewing.
  cancelAtPeriodEnd      Boolean            @default(false) @map("cancel_at_period_end")
  /// When a scheduled cancellation ends the subscription (the trial or period end); null when
  /// it renews.
  cancelAt               DateTime?          @map("cancel_at")
  /// When the subscription became past due; the grace period runs from here. Null otherwise.
  pastDueSince           DateTime?          @map("past_due_since")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  @@index([planVersionId])
  @@map("organization_subscriptions")
}

/// Billing provider webhook events already handled, so a redelivered event is applied once.
model BillingWebhookEvent {
  /// The provider's event id (a Stripe `evt_` id).
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("billing_webhook_events")
}

// ─── Catalog ──────────────────────────────────────────────────────────────────

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum OutOfStockPolicy {
  STOP_SELLING
  CONTINUE_SELLING

  @@map("out_of_stock_policy")
}

/// A saved filter of the product list, shared by everyone in the workspace.
model ProductView {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @map("workspace_id") @db.Uuid
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  search      String?
  status      ProductStatus?
  /// A `CatalogGap` value; validated by the API, kept as text so new gaps need no migration.
  gap         String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@unique([workspaceId, name])
  @@map("product_views")
}

/// A product with its base content. Per-channel overrides live on its listings.
model Product {
  id              String         @id @default(uuid()) @db.Uuid
  workspaceId     String         @map("workspace_id") @db.Uuid
  workspace       Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  handle          String
  title           String
  descriptionHtml String         @default("") @map("description_html")
  vendor          String?
  productType     String?        @map("product_type")
  tags            String[]
  status          ProductStatus  @default(DRAFT)
  /// Names of up to three options (Size, Color). Each variant holds one value per name, in order.
  optionNames     String[]       @map("option_names")
  variants        Variant[]
  media           ProductMedia[]
  listings        Listing[]
  suggestions     Suggestion[]
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([workspaceId, handle])
  @@index([workspaceId, title, id])
  @@map("products")
}

model Variant {
  id               String                   @id @default(uuid()) @db.Uuid
  workspaceId      String                   @map("workspace_id") @db.Uuid
  productId        String                   @map("product_id") @db.Uuid
  product          Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  position         Int
  sku              String?
  barcode          String?
  optionValues     String[]                 @map("option_values")
  price            Decimal                  @db.Decimal(12, 2)
  compareAtPrice   Decimal?                 @map("compare_at_price") @db.Decimal(12, 2)
  /// What the merchant pays per unit. Drives pricing floors; never shown to buyers.
  cost             Decimal?                 @db.Decimal(12, 2)
  weightGrams      Int?                     @map("weight_grams")
  requiresShipping Boolean                  @default(true) @map("requires_shipping")
  taxable          Boolean                  @default(true)
  outOfStockPolicy OutOfStockPolicy         @default(STOP_SELLING) @map("out_of_stock_policy")
  inventoryItem    InventoryItem?
  listingVariants  ListingVariant[]
  listingPrices    ListingVariantOverride[]
  orderLines       OrderLine[]
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  @@unique([workspaceId, sku])
  @@index([productId, position])
  @@map("variants")
}

model ProductMedia {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  altText     String?  @map("alt_text")
  position    Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([productId, position])
  /// Finds the media that use an uploaded file (`Upload.url`), for the orphan cleanup.
  @@index([workspaceId, url])
  @@map("product_media")
}

/// A file uploaded to Crossmart's storage. The workspace's storage use is the sum of `byteSize`.
/// Only files we stored are recorded here, so images imported from a channel (external URLs)
/// are never cleaned up. There is deliberately no foreign key to `Workspace`: when a workspace
/// is deleted its rows stay, become orphans, and the cleanup deletes their files.
model Upload {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  /// Where the file sits in `FileStorage`.
  storageKey  String    @unique @map("storage_key")
  /// The public URL product media reference the file by.
  url         String
  byteSize    BigInt    @map("byte_size")
  contentType String    @map("content_type")
  /// Set when no product media of the workspace uses the file, cleared when one does again.
  /// The file is deleted once it has been an orphan for the grace period.
  orphanedAt  DateTime? @map("orphaned_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, url])
  @@index([orphanedAt, workspaceId])
  @@map("uploads")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

enum InventoryMovementReason {
  /// Stock a variant was created or imported with.
  OPENING_BALANCE
  /// Stock changed by editing the product.
  ADJUSTMENT
  /// A count that corrects the recorded stock.
  CORRECTION
  RECEIVED
  RETURNED
  DAMAGED
  LOST
  /// Sold outside a connected channel (a market stall, a wholesale order).
  SOLD
  /// Stock set by an inventory file import.
  IMPORTED
  /// Units a channel order shipped: they leave the stock on hand.
  ORDER_SHIPPED

  @@map("inventory_movement_reason")
}

/// Stock of one variant. On hand = `available` + `reserved`.
/// `available` can be sold and is what channels receive; `reserved` is held for open orders.
/// The movements sum to the stock on hand, and both columns are updated atomically with them.
model InventoryItem {
  id          String              @id @default(uuid()) @db.Uuid
  workspaceId String              @map("workspace_id") @db.Uuid
  variantId   String              @unique @map("variant_id") @db.Uuid
  variant     Variant             @relation(fields: [variantId], references: [id], onDelete: Cascade)
  tracked     Boolean             @default(true)
  available   Int                 @default(0)
  reserved    Int                 @default(0)
  movements   InventoryMovement[]
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([workspaceId, tracked, available])
  @@map("inventory_items")
}

/// Append-only ledger of changes to the stock on hand. Reservations move units between
/// `available` and `reserved` and are not movements.
model InventoryMovement {
  id              String                  @id @default(uuid()) @db.Uuid
  workspaceId     String                  @map("workspace_id") @db.Uuid
  inventoryItemId String                  @map("inventory_item_id") @db.Uuid
  inventoryItem   InventoryItem           @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  delta           Int
  reason          InventoryMovementReason
  /// Stock on hand right after this movement.
  quantityAfter   Int                     @map("quantity_after")
  note            String?
  /// The signed-in user who made the change; null for API keys, the system and deleted users.
  actorUserId     String?                 @map("actor_user_id") @db.Uuid
  actorUser       User?                   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  /// Set when the change came through an API key (an agent or a script).
  apiKeyId        String?                 @map("api_key_id") @db.Uuid
  apiKey          ApiKey?                 @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  createdAt       DateTime                @default(now()) @map("created_at")

  @@index([inventoryItemId, createdAt])
  @@index([actorUserId])
  @@index([apiKeyId])
  @@map("inventory_movements")
}

// ─── Activity ─────────────────────────────────────────────────────────────────

enum ActivityActorType {
  USER
  API_KEY
  /// An AI agent connected with OAuth, acting for the user in `actorUserId`.
  AGENT
  SYSTEM

  @@map("activity_actor_type")
}

enum ActivityOutcome {
  SUCCEEDED
  FAILED

  @@map("activity_outcome")
}

/// Append-only record of who changed what in a workspace, including operations that failed.
/// UUIDv7 ids sort by time, so they break ties between events of the same millisecond.
model ActivityEvent {
  id                 String            @id @default(uuid(7)) @db.Uuid
  workspaceId        String            @map("workspace_id") @db.Uuid
  workspace          Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorType          ActivityActorType @map("actor_type")
  /// Kept as null when the user is deleted, so the history survives them.
  actorUserId        String?           @map("actor_user_id") @db.Uuid
  actorUser          User?             @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorApiKeyId      String?           @map("actor_api_key_id") @db.Uuid
  actorApiKey        ApiKey?           @relation(fields: [actorApiKeyId], references: [id], onDelete: SetNull)
  /// The connected agent (an OAuth client id) for an `AGENT` actor.
  actorOAuthClientId String?           @map("actor_oauth_client_id")
  actorOAuthClient   OauthClient?      @relation(fields: [actorOAuthClientId], references: [clientId], onDelete: SetNull)
  /// The agent's name, kept when its unused registration is deleted, so its history still names it.
  actorAgentName     String?           @map("actor_agent_name")
  /// An `ActivityAction` value; kept as text so features can add actions without a migration.
  action             String
  outcome            ActivityOutcome
  /// An `ActivitySubjectType` value, kept as text for the same reason.
  subjectType        String?           @map("subject_type")
  subjectId          String?           @map("subject_id") @db.Uuid
  /// The subject's name when the event happened, so deleted subjects still read well.
  subjectLabel       String?           @map("subject_label")
  /// Every subject a bulk event touched, so each one's history includes it.
  subjectIds         String[]          @map("subject_ids") @db.Uuid
  /// How many items the event covered (products changed, products imported).
  itemCount          Int?              @map("item_count")
  /// A short, user-facing reason for a failed outcome. Never holds secrets.
  failureReason      String?           @map("failure_reason")
  summary            String
  createdAt          DateTime          @default(now()) @map("created_at")

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, subjectType, subjectId])
  @@index([subjectIds], type: Gin)
  @@index([actorOAuthClientId, createdAt])
  @@map("activity_events")
}

// ─── Imports ──────────────────────────────────────────────────────────────────

enum ImportJobStatus {
  PROCESSING
  COMPLETED
  FAILED

  @@map("import_job_status")
}

enum ImportIssueOutcome {
  /// The record was left as it was (already in the catalog, not found, stock not tracked).
  SKIPPED
  /// The record could not be imported (invalid value, unknown SKU, SKU clash).
  FAILED

  @@map("import_issue_outcome")
}

/// One import and what it did to the catalog, from an uploaded file or a channel's catalog:
/// the workspace's import history.
model ImportJob {
  id           String             @id @default(uuid()) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// The signed-in user who sent the file; null for API keys and deleted users.
  userId       String?            @map("user_id") @db.Uuid
  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// The API key that sent the file, if one did.
  apiKeyId     String?            @map("api_key_id") @db.Uuid
  apiKey       ApiKey?            @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  /// A `CatalogImportMode` value; validated by the API, kept as text so new modes need no migration.
  mode         String
  /// A `CatalogImportFormat` value, kept as text for the same reason.
  format       String
  /// The uploaded file's name, or the name of the channel account a channel import read.
  fileName     String             @map("file_name")
  /// The channel account a channel import reads; null for file imports and deleted connections.
  connectionId String?            @map("connection_id") @db.Uuid
  connection   ChannelConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// Where a channel import resumes: the channel's cursor after the last page it wrote.
  cursor       String?
  /// How many records the source holds, when it says, so progress can be shown.
  totalCount   Int?               @map("total_count")
  status       ImportJobStatus    @default(PROCESSING)
  createdCount Int                @default(0) @map("created_count")
  /// Channel products matched to catalog products (by handle or SKU) and linked to them.
  linkedCount  Int                @default(0) @map("linked_count")
  updatedCount Int                @default(0) @map("updated_count")
  skippedCount Int                @default(0) @map("skipped_count")
  failedCount  Int                @default(0) @map("failed_count")
  /// Why the whole file was rejected, when `status` is FAILED.
  errorMessage String?            @map("error_message")
  issues       ImportJobIssue[]
  createdAt    DateTime           @default(now()) @map("created_at")
  /// Moves with every page a running import writes, so a stalled one can be found.
  updatedAt    DateTime           @default(now()) @updatedAt @map("updated_at")
  finishedAt   DateTime?          @map("finished_at")

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([connectionId, status])
  @@index([status, updatedAt])
  @@map("import_jobs")
}

/// A skipped or failed record of an import, in file order.
model ImportJobIssue {
  id          String             @id @default(uuid()) @db.Uuid
  workspaceId String             @map("workspace_id") @db.Uuid
  jobId       String             @map("job_id") @db.Uuid
  job         ImportJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  position    Int
  outcome     ImportIssueOutcome
  /// An `ImportIssueCode` value, kept as text so new codes need no migration.
  code        String
  message     String
  handle      String?
  sku         String?
  /// Spreadsheet row number, counting the header as row 1.
  row         Int?

  @@index([jobId, position])
  @@map("import_job_issues")
}

// ─── Channels ─────────────────────────────────────────────────────────────────

/// The key that encrypts a workspace's secrets (channel credentials), wrapped by a master key.
model WorkspaceDataKey {
  workspaceId      String    @id @map("workspace_id") @db.Uuid
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// AES-256-GCM sealed data key; never stored in plain text.
  wrappedKey       String    @map("wrapped_key")
  /// Which master key wrapped it, so keys can be rotated.
  masterKeyVersion Int       @map("master_key_version")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("workspace_data_keys")
}

enum ChannelConnectionStatus {
  CONNECTED
  /// The channel no longer accepts the credentials; the merchant must connect again.
  NEEDS_REAUTH
  /// Disconnected by the merchant, or the app was uninstalled. Credentials are wiped.
  DISCONNECTED
  /// The last sync or account check failed for another reason.
  ERROR

  @@map("channel_connection_status")
}

/// A workspace's account on a channel, such as one Shopify store.
model ChannelConnection {
  id                   String                  @id @default(uuid()) @db.Uuid
  workspaceId          String                  @map("workspace_id") @db.Uuid
  workspace            Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// A `ChannelType` value; kept as text so new channels need no migration.
  channel              String
  /// The account on the channel: a Shopify store's `*.myshopify.com` domain.
  externalAccountId    String                  @map("external_account_id")
  displayName          String                  @map("display_name")
  status               ChannelConnectionStatus @default(CONNECTED)
  /// The connector's credentials as JSON, sealed with the workspace data key. Null once wiped.
  credentials          String?
  /// When the access token expires, so it can be refreshed ahead of time. Not a secret.
  credentialsExpiresAt DateTime?               @map("credentials_expires_at")
  grantedScopes        String[]                @map("granted_scopes")
  /// Account settings typed per channel and validated by its connector (currency, location).
  settings             Json                    @default("{}")
  /// A short, user-facing reason for `NEEDS_REAUTH` or `ERROR`. Never holds secrets.
  statusReason         String?                 @map("status_reason")
  connectedById        String?                 @map("connected_by_id") @db.Uuid
  connectedBy          User?                   @relation(fields: [connectedById], references: [id], onDelete: SetNull)
  connectedAt          DateTime                @default(now()) @map("connected_at")
  disconnectedAt       DateTime?               @map("disconnected_at")
  lastSyncedAt         DateTime?               @map("last_synced_at")
  /// Orders changed up to this time have been read; the next poll reads from here.
  ordersPolledAt       DateTime?               @map("orders_polled_at")
  /// When Crossmart started reading orders; earlier orders were sold from stock it never held.
  ordersSyncedFrom     DateTime?               @map("orders_synced_from")
  listings             Listing[]
  importJobs           ImportJob[]
  orders               Order[]
  suggestions          Suggestion[]
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@unique([workspaceId, channel, externalAccountId])
  /// Webhooks name the account, not the workspace.
  @@index([channel, externalAccountId])
  @@map("channel_connections")
}

enum ListingStatus {
  /// Waiting to be published.
  PENDING
  /// Live on the channel.
  ACTIVE
  /// On the channel but not for sale (a draft or archived product).
  INACTIVE
  /// The last publish or update failed; see `lastError`.
  ERROR
  /// Removed from the channel.
  DELISTED

  @@map("listing_status")
}

/// How a product joined a connection, which decides how it leaves.
enum ListingSource {
  /// Added to the store by hand; it stays until it is removed by hand.
  MANUAL
  /// Brought in by a catalog import from the channel; it stays like a manual one.
  IMPORT
  /// Matched the connection's automatic rule; it leaves when the rule stops matching.
  RULE

  @@map("listing_source")
}

/// A product on one channel connection, with the ids the channel gave it. A product may have
/// several listings on one connection (eBay variations of title or pack size), so only the
/// external id is unique per connection.
model Listing {
  id                  String                   @id @default(uuid()) @db.Uuid
  workspaceId         String                   @map("workspace_id") @db.Uuid
  connectionId        String                   @map("connection_id") @db.Uuid
  connection          ChannelConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  productId           String                   @map("product_id") @db.Uuid
  product             Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The product's id on the channel (a Shopify product GID, an eBay listing id); null until it is published.
  externalId          String?                  @map("external_id")
  externalUrl         String?                  @map("external_url")
  status              ListingStatus            @default(PENDING)
  source              ListingSource            @default(RULE)
  /// A short, user-facing reason for `ERROR`. Never holds secrets.
  lastError           String?                  @map("last_error")
  /// What the last publish was refused for lacking (a connector `PublishRequirement`, such as
  /// `item_specifics`), so the merchant is asked for details instead of a retry. Null otherwise.
  missingRequirement  String?                  @map("missing_requirement")
  lastSyncedAt        DateTime?                @map("last_synced_at")
  /// A digest of the images last sent, so an update re-sends media only when they changed.
  mediaDigest         String?                  @map("media_digest")
  /// The channel category the listing is in (an eBay leaf category id), chosen by the merchant
  /// or picked on first publish; null for channels without categories.
  channelCategoryId   String?                  @map("channel_category_id")
  /// The category with its ancestors, as the channel names it: "Home & Garden > Kitchen > Mugs".
  channelCategoryName String?                  @map("channel_category_name")
  /// When a sync or retry queued this listing's publish, update or delist; cleared once its job
  /// finishes (or gives up). Lets the store show it publishing and say when a sync is done.
  syncRequestedAt     DateTime?                @map("sync_requested_at")
  variants            ListingVariant[]
  override            ListingOverride?
  variantOverrides    ListingVariantOverride[]
  itemSpecifics       ListingItemSpecific[]
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@unique([connectionId, externalId])
  @@index([connectionId, status])
  @@index([connectionId, source])
  @@index([connectionId, productId])
  @@index([workspaceId, productId])
  /// A store's listings with a sync job still outstanding, for its sync progress.
  @@index([connectionId, syncRequestedAt])
  /// Sync requests left unsettled for too long, across stores, for the sweep that queues them again.
  @@index([syncRequestedAt])
  /// Active listings are counted per organization for plan limits.
  @@index([workspaceId, status])
  @@map("listings")
}

/// Maps a variant to its ids on a listing's channel, for price and stock sync.
model ListingVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  listingId           String   @map("listing_id") @db.Uuid
  listing             Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variantId           String   @map("variant_id") @db.Uuid
  variant             Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  /// The variant's id on the channel (a Shopify ProductVariant GID, an eBay SKU).
  externalId          String   @map("external_id")
  /// The id stock is set on, where the channel has one (a Shopify InventoryItem GID, an eBay SKU).
  externalInventoryId String?  @map("external_inventory_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@unique([listingId, variantId])
  @@unique([listingId, externalId])
  @@index([variantId])
  @@map("listing_variants")
}

/// An item specific the merchant set on one listing (an eBay aspect such as `Color`), sent on
/// publish ahead of the defaults Crossmart derives. Values are kept in the merchant's order.
model ListingItemSpecific {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  /// The aspect's name as the channel names it, such as `Color` or `Material`.
  name        String
  values      String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([listingId, name])
  @@index([workspaceId])
  @@map("listing_item_specifics")
}

/// Whether a listing is for sale on its channel, when the merchant decides it per channel.
enum ListingVisibility {
  /// For sale on the channel, even while the product is a draft in Crossmart.
  VISIBLE
  /// On the channel but hidden (a draft there), whatever the product's status.
  HIDDEN

  @@map("listing_visibility")
}

/// What one listing shows differently from the product (ChannelContent). Null fields follow the product.
model ListingOverride {
  id              String             @id @default(uuid()) @db.Uuid
  workspaceId     String             @map("workspace_id") @db.Uuid
  listingId       String             @unique @map("listing_id") @db.Uuid
  listing         Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  title           String?
  descriptionHtml String?            @map("description_html")
  /// The brand this channel shows instead of the product's vendor.
  vendor          String?
  /// Tags replace the product's when `tagsOverridden` is set (an empty list means no tags).
  tagsOverridden  Boolean            @default(false) @map("tags_overridden")
  tags            String[]
  /// The product's images to show, in order, by URL, when `mediaOverridden` is set.
  mediaOverridden Boolean            @default(false) @map("media_overridden")
  mediaUrls       String[]           @map("media_urls")
  visibility      ListingVisibility?
  /// Units held back from this channel: it shows available minus the buffer.
  inventoryBuffer Int?               @map("inventory_buffer")
  /// The most units this channel shows, however many are available.
  maxQuantity     Int?               @map("max_quantity")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("listing_overrides")
}

/// A fixed price for one variant on one listing, ahead of the connection's pricing rule.
model ListingVariantOverride {
  id             String   @id @default(uuid()) @db.Uuid
  workspaceId    String   @map("workspace_id") @db.Uuid
  listingId      String   @map("listing_id") @db.Uuid
  listing        Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  variantId      String   @map("variant_id") @db.Uuid
  variant        Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  price          Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([listingId, variantId])
  @@index([variantId])
  @@map("listing_variant_overrides")
}

/// Where a channel order stands, from its lines: nothing shipped, some, all, or cancelled.
enum OrderStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED

  @@map("order_status")
}

/// An order from a connected channel, kept once per channel order. It holds no buyer details.
model Order {
  id                String            @id @default(uuid()) @db.Uuid
  workspaceId       String            @map("workspace_id") @db.Uuid
  workspace         Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectionId      String            @map("connection_id") @db.Uuid
  connection        ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId        String            @map("external_id")
  /// The number the merchant and buyer see, such as `#1001`.
  name              String
  status            OrderStatus
  currencyCode      String            @map("currency_code")
  total             Decimal           @db.Decimal(12, 2)
  placedAt          DateTime          @map("placed_at")
  /// When the channel last changed the order, so an older copy never overwrites a newer one.
  externalUpdatedAt DateTime          @map("external_updated_at")
  lines             OrderLine[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@unique([connectionId, externalId])
  @@index([workspaceId, placedAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, status])
  @@map("orders")
}

/// One line of an order, and the stock it holds: `reservedQuantity` waits to ship,
/// `fulfilledQuantity` has left the stock on hand. Lines that match no variant hold none.
model OrderLine {
  id                String   @id @default(uuid()) @db.Uuid
  workspaceId       String   @map("workspace_id") @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  externalId        String   @map("external_id")
  variantId         String?  @map("variant_id") @db.Uuid
  variant           Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  sku               String?
  title             String
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  fulfilledQuantity Int      @default(0) @map("fulfilled_quantity")

  @@unique([orderId, externalId])
  @@index([variantId])
  @@map("order_lines")
}

// ─── Currency ─────────────────────────────────────────────────────────────────

/// A daily reference rate: how many units of `currency` one euro buys, as the European Central
/// Bank published it on `publishedOn`. Any pair is converted through the euro.
model ExchangeRate {
  id          String   @id @default(uuid()) @db.Uuid
  currency    String   @db.Char(3)
  ratePerEuro Decimal  @map("rate_per_euro") @db.Decimal(18, 6)
  publishedOn DateTime @map("published_on") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([currency, publishedOn])
  @@index([publishedOn])
  @@map("exchange_rates")
}

// ─── AI ───────────────────────────────────────────────────────────────────────

/// Where a suggestion stands. Only PENDING suggestions can be approved or rejected.
enum SuggestionStatus {
  PENDING
  /// Approved and written through the same service a user edit goes through.
  APPLIED
  REJECTED
  /// The value it would replace changed after it was made (or a newer suggestion replaced it).
  STALE

  @@map("suggestion_status")
}

/// Who made a suggestion: an internal agent, a user, or an API key (an external agent).
enum SuggestionCreatorType {
  AGENT
  USER
  API_KEY

  @@map("suggestion_creator_type")
}

/// A proposed change to a product, optionally on one channel connection, waiting for review.
/// Approving it applies the change through the domain service a user would call.
model Suggestion {
  id                  String                @id @default(uuid(7)) @db.Uuid
  workspaceId         String                @map("workspace_id") @db.Uuid
  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId           String                @map("product_id") @db.Uuid
  product             Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// The connection the change is for; null for a change to the product's base content.
  connectionId        String?               @map("connection_id") @db.Uuid
  connection          ChannelConnection?    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// A `SuggestionKind` value; kept as text so new kinds need no migration.
  kind                String
  status              SuggestionStatus      @default(PENDING)
  /// The value the change replaces, as it was when the suggestion was made.
  currentValue        String                @map("current_value")
  proposedValue       String                @map("proposed_value")
  rationale           String
  createdByType       SuggestionCreatorType @map("created_by_type")
  /// A `SuggestionAgent` value for suggestions agents made.
  agent               String?
  /// The user or API key that asked for it (and made it, unless an agent did).
  requestedByUserId   String?               @map("requested_by_user_id") @db.Uuid
  requestedByUser     User?                 @relation("SuggestionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedByApiKeyId String?               @map("requested_by_api_key_id") @db.Uuid
  requestedByApiKey   ApiKey?               @relation("SuggestionRequestedByKey", fields: [requestedByApiKeyId], references: [id], onDelete: SetNull)
  reviewedByUserId    String?               @map("reviewed_by_user_id") @db.Uuid
  reviewedByUser      User?                 @relation("SuggestionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedByApiKeyId  String?               @map("reviewed_by_api_key_id") @db.Uuid
  reviewedByApiKey    ApiKey?               @relation("SuggestionReviewedByKey", fields: [reviewedByApiKeyId], references: [id], onDelete: SetNull)
  reviewedAt          DateTime?             @map("reviewed_at")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  @@index([workspaceId, status, createdAt(sort: Desc), id(sort: Desc)])
  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([productId, connectionId, kind, status])
  @@index([connectionId])
  @@map("suggestions")
}

/// One metered AI call: who it was for, what it did and how many tokens it used.
/// Append-only; credits and plan limits are computed from it.
model AiUsage {
  id           String    @id @default(uuid(7)) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// An `AiFeature` value; kept as text so new features need no migration.
  feature      String
  /// An `AiProviderName` value.
  provider     String
  model        String
  inputTokens  Int       @map("input_tokens")
  outputTokens Int       @map("output_tokens")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@map("ai_usage")
}

/// AI calls Crossmart pays for itself, outside any workspace, such as Ask Crossmart's answers to
/// public questions. Kept apart from `ai_usage` so no tenant row is ever written without a
/// workspace, and so platform spend can be reported on its own.
model PlatformAiUsage {
  id           String   @id @default(uuid(7)) @db.Uuid
  /// An `AiFeature` value; kept as text so new features need no migration.
  feature      String
  /// An `AiProviderName` value.
  provider     String
  model        String
  inputTokens  Int      @map("input_tokens")
  outputTokens Int      @map("output_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([feature, createdAt])
  @@map("platform_ai_usage")
}

// ─── Outgoing webhooks (ADR 0023) ─────────────────────────────────────────────

/// Why an endpoint receives no events. An endpoint without a reason is enabled.
enum WebhookDisabledReason {
  /// Someone in the workspace turned it off.
  MANUAL
  /// Crossmart turned it off after too many failed deliveries in a row.
  FAILING
}

enum WebhookDeliveryStatus {
  /// Waiting for its first attempt.
  PENDING
  /// An attempt failed; another one is scheduled at `next_attempt_at`.
  RETRYING
  SUCCEEDED
  /// Every attempt failed, or the endpoint was disabled before it went through.
  FAILED
}

/// How the latest attempt to deliver to an endpoint ended.
enum WebhookAttemptOutcome {
  /// The endpoint answered 2xx.
  SUCCEEDED
  /// Any other answer, a timeout, a connection error or a redirect.
  FAILED
}

/// A URL a workspace receives events at, signed with its own secret.
model WebhookEndpoint {
  id                      String                 @id @default(uuid()) @db.Uuid
  workspaceId             String                 @map("workspace_id") @db.Uuid
  workspace               Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url                     String
  description             String?
  /// `WebhookEventType` values; text, so a new event type needs no migration.
  eventTypes              String[]               @map("event_types")
  /// The signing secret, sealed with the workspace's data key. Never returned after creation.
  sealedSecret            String                 @map("sealed_secret")
  /// The secret a rotation replaced; deliveries are signed with both until it expires.
  previousSealedSecret    String?                @map("previous_sealed_secret")
  previousSecretExpiresAt DateTime?              @map("previous_secret_expires_at")
  disabledReason          WebhookDisabledReason? @map("disabled_reason")
  disabledAt              DateTime?              @map("disabled_at")
  /// Failed attempts since the last one that went through; reaching the limit disables it.
  consecutiveFailures     Int                    @default(0) @map("consecutive_failures")
  /// The latest delivery attempt, across events, kept here so listing endpoints reads no deliveries.
  lastAttemptAt           DateTime?              @map("last_attempt_at")
  lastAttemptOutcome      WebhookAttemptOutcome? @map("last_attempt_outcome")
  /// The HTTP status of the latest attempt; null when no response came.
  lastResponseStatus      Int?                   @map("last_response_status")
  /// Why the latest attempt failed, safe to show; null after a success.
  lastAttemptError        String?                @map("last_attempt_error")
  deliveries              WebhookDelivery[]
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("webhook_endpoints")
}

/// Something that happened in a workspace, as it is sent: written in the same transaction as the
/// change itself (the outbox), so no event is lost and none is made up.
model WebhookEvent {
  id          String            @id @db.Uuid
  workspaceId String            @map("workspace_id") @db.Uuid
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// A `WebhookEventType` value.
  type        String
  apiVersion  String            @map("api_version")
  /// The event's `data`, as every endpoint receives it.
  data        Json
  deliveries  WebhookDelivery[]
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([createdAt])
  @@map("webhook_events")
}

/// One event on its way to one endpoint, with the outcome of its latest attempt.
model WebhookDelivery {
  id             String                @id @db.Uuid
  workspaceId    String                @map("workspace_id") @db.Uuid
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventId        String                @map("event_id") @db.Uuid
  event          WebhookEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpointId     String                @map("endpoint_id") @db.Uuid
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  /// When the next attempt is due; null once the delivery is settled.
  nextAttemptAt  DateTime?             @map("next_attempt_at")
  /// A worker holds the delivery until then; a crashed worker's claim expires and is retried.
  leaseExpiresAt DateTime?             @map("lease_expires_at")
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  deliveredAt    DateTime?             @map("delivered_at")
  /// The HTTP status of the latest attempt; null when no response came.
  responseStatus Int?                  @map("response_status")
  durationMs     Int?                  @map("duration_ms")
  /// Why the latest attempt failed, safe to show: never response bodies or secrets.
  error          String?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([endpointId, createdAt])
  @@index([eventId])
  @@index([createdAt])
  @@map("webhook_deliveries")
}

// ─── Ask Crossmart conversations and escalations (ADR 0025) ──────────────────
// Closed sets (channel, caller type, outcome, confidence, escalation reason and status) are
// TypeScript string enums stored as text, like `platform_ai_usage.feature`, so a new value
// needs no migration. Raw IP addresses are never stored: only salted hashes.

/// One conversation with Ask Crossmart, from any channel. Kept for `ASK_RETENTION_DAYS`.
model AskConversation {
  id                String            @id @default(uuid(7)) @db.Uuid
  /// The unguessable id the caller continues the conversation with (`conv_…`, the A2A
  /// `contextId`). Only the caller it is bound to (`ownerKey`) can continue it.
  publicId          String            @unique @map("public_id")
  /// An `AskChannel`: web_widget, app_widget, api, mcp or a2a.
  channel           String
  /// An `AskCallerType`: anonymous, user, api_key or agent.
  callerType        String            @map("caller_type")
  /// The agent's client name, for agents.
  clientName        String?           @map("client_name")
  /// Salted hash of who may continue the conversation (the principal, or the client fingerprint).
  ownerKey          String            @map("owner_key")
  /// Salted hash of the caller's IP address and user agent; never the raw values.
  clientFingerprint String            @map("client_fingerprint")
  workspaceId       String?           @map("workspace_id") @db.Uuid
  workspace         Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId            String?           @map("user_id") @db.Uuid
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  turnCount         Int               @default(0) @map("turn_count")
  /// When a turn was last added; the conversation expires `ASK_CONVERSATION_IDLE_MS` after it.
  lastActivityAt    DateTime          @default(now()) @map("last_activity_at")
  /// When it was first escalated to a person; null while it was not.
  escalatedAt       DateTime?         @map("escalated_at")
  turns             AskTurn[]
  escalations       AskEscalation[]
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([lastActivityAt])
  @@index([ownerKey, lastActivityAt])
  @@map("ask_conversations")
}

/// One question and its answer. The question is stored with obvious secrets redacted.
model AskTurn {
  id                String          @id @default(uuid(7)) @db.Uuid
  conversationId    String          @map("conversation_id") @db.Uuid
  conversation      AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// 1 for the first question of the conversation.
  position          Int
  question          String
  /// SHA-256 of the normalised, redacted question, to count questions asked alike.
  questionHash      String          @map("question_hash")
  answer            String
  /// An `AskOutcome`.
  outcome           String
  /// An `AskConfidence`.
  confidence        String
  /// `[{ title, url }]`: the pages (or account data) the answer cites.
  citations         Json
  /// Which `AccountLookupKind`s ran for this answer; empty for docs-only answers.
  accountLookups    String[]        @map("account_lookups")
  /// Why a person was offered (an `AskEscalationReason`); null when none was.
  escalationReason  String?         @map("escalation_reason")
  latencyMs         Int             @map("latency_ms")
  /// The model that answered; null when no model was called (cache, no relevant docs).
  model             String?
  /// True when the answer came from the answer cache.
  cached            Boolean         @default(false)
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([conversationId, position])
  @@index([createdAt])
  @@index([outcome, createdAt])
  @@index([questionHash])
  @@map("ask_turns")
}

/// A conversation handed to a person, with the reply once one is sent.
model AskEscalation {
  id                  String          @id @default(uuid(7)) @db.Uuid
  conversationId      String          @map("conversation_id") @db.Uuid
  conversation        AskConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// SHA-256 of the ticket id the caller holds (and polls with); the id itself is never stored.
  tokenHash           String          @unique @map("token_hash")
  /// An `AskEscalationReason`.
  reason              String
  /// An `AskEscalationStatus`: open or replied.
  status              String
  contactEmail        String?         @map("contact_email")
  /// Where the reply is POSTed, signed like outgoing webhooks (ADR 0023).
  callbackUrl         String?         @map("callback_url")
  reply               String?
  repliedAt           DateTime?       @map("replied_at")
  /// The platform admin who replied.
  repliedBy           String?         @map("replied_by")
  callbackDeliveredAt DateTime?       @map("callback_delivered_at")
  /// Why the callback failed, safe to show; null when it succeeded or was not attempted.
  callbackError       String?         @map("callback_error")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([status, createdAt])
  @@map("ask_escalations")
}
