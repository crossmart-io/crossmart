{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "import", "promise", "vitest"],
  "env": {
    "node": true
  },
  "ignorePatterns": ["dist", "coverage", "libs/database/src/generated"],
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/explicit-function-return-type": ["warn", { "allowExpressions": true }],
    "eslint/no-magic-numbers": [
      "error",
      {
        "ignore": [-1, 0, 1],
        "ignoreEnums": true,
        "ignoreReadonlyClassProperties": true,
        "ignoreTypeIndexes": true,
        "ignoreDefaultValues": true
      }
    ],
    "eslint/no-console": "error",
    "eslint/id-length": ["error", { "min": 2, "exceptions": ["_"] }],
    "eslint/max-lines-per-function": [
      "warn",
      { "max": 40, "skipBlankLines": true, "skipComments": true }
    ],
    "eslint/max-params": ["warn", { "max": 4 }],
    "eslint/complexity": ["warn", 10],
    "eslint/eqeqeq": "error",
    "eslint/no-var": "error",
    "eslint/prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["**/*.spec.ts", "**/*.e2e-spec.ts", "**/test/**"],
      "rules": {
        "eslint/no-magic-numbers": "off",
        "eslint/max-lines-per-function": "off",
        "typescript/explicit-function-return-type": "off",
        "vitest/require-mock-type-parameters": "off"
      }
    },
    {
      "files": ["**/*.constants.ts", "**/*.config.ts"],
      "rules": {
        "eslint/no-magic-numbers": "off"
      }
    }
  ]
}
